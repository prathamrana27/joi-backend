# ---- LLM provider ----
# "openai" (default, needs OPENAI_API_KEY) | "ollama" (local, free, no key) | "openai_compatible"
JOI_LLM_PROVIDER=openai
JOI_OPENAI_MODEL=gpt-4o
# For local Ollama (install from https://ollama.com, then: `ollama pull llama3.1:8b`)
JOI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
JOI_OLLAMA_MODEL=llama3.1:8b
# Generic OpenAI-compatible endpoint (Groq / Together / Fireworks / vLLM)
JOI_LLM_BASE_URL=
JOI_LLM_API_KEY=
JOI_LLM_MODEL=
JOI_LLM_TEMPERATURE=1
JOI_LLM_MAX_TOKENS=4096
