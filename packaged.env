# ==========================================================================
#  JOI runtime settings shipped inside the installer.
#  NEVER put real secrets here: everything in this file is readable by anyone
#  who downloads JOI. The desktop app copies it to the user's data folder on
#  first run and generates a per-install AUTH_JWT_SECRET.
# ==========================================================================

# ---- AI model (local, bundled with JOI's first-run setup) ----
JOI_LLM_PROVIDER=ollama
JOI_OLLAMA_BASE_URL=http://127.0.0.1:11434
JOI_OLLAMA_MODEL=qwen2.5:3b
JOI_OLLAMA_NUM_CTX=8192
JOI_OLLAMA_KEEP_ALIVE=-1
JOI_LLM_TEMPERATURE=0.3
JOI_LLM_MAX_TOKENS=1024

# ---- Voice: local speech-to-text; cloud voice needs a key (not shipped) ----
JOI_VOICE_PROVIDER=
JOI_LOCAL_WHISPER_MODEL=base

# ---- Local storage. The desktop app starts the bundled database and sets
#      MONGO_URI itself; Redis is optional (in-memory cache when absent). ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=joi_local
REDIS_URL=

# ---- Sign-in ----
AUTH_JWT_SECRET=
AUTH_JWT_EXP_SECONDS=604800

# ---- Google / Slack connectors ----
# Client IDs are public. Client secrets must come from the hosted broker
# (see docs/HYBRID_ARCHITECTURE.md), not from this file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_CLIENT_IDS=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://127.0.0.1:8000/integrations/slack/callback
